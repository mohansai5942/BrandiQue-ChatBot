# AI provider order
PROVIDER_ORDER=openrouter,gemini

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Provider timeouts and temporary cooldown after rate limits/timeouts
OPENROUTER_TIMEOUT_MS=6000
GEMINI_TIMEOUT_MS=7000
PROVIDER_COOLDOWN_MS=3600000

# Railway/local server
PORT=3000
SITE_URL=https://www.brandique.in

# Google Apps Script Web App endpoint
GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbyXzGw4qX9QDef9vLC4p2RJy6q9TNoGOfNxESR_nw-IiyrEdKdlAa6csThBndHw5QTs_Q/exec
